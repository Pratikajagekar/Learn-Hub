NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Leave MONGO_URI empty to use the built-in embedded MongoDB (data saved in ../.mongo-data)
# To use your own MongoDB / Atlas, set e.g. MONGO_URI=mongodb://127.0.0.1:27017/lms
MONGO_URI=
JWT_SECRET=dev_secret_change_me_in_production_9f8a7b6c5d4e3f2a1b
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7
PLATFORM_FEE_PERCENT=20
CURRENCY=usd
# Optional: Stripe. Empty = demo checkout (orders are completed instantly, no real payment)
STRIPE_SECRET_KEY=
# Optional: Cloudinary. Empty = uploads are stored locally in server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional compiler service (Judge0-compatible). Defaults to the public CE endpoint.
JUDGE0_URL=https://ce.judge0.com
# If using a hosted RapidAPI Judge0 instance, set its key and host.
JUDGE0_API_KEY=
JUDGE0_API_HOST=
